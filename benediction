def command_hook(g, sq):
    """Bringing the relics home, with the Matriarch dead, ends the game."""
    if g.st.won:
        return False
    if not (g.flag('matriarch') and g.has_item('burninghand') and
            g.has_item('litany') and g.has_item('heart')):
        return False
    g.take_item('litany')
    g.take_item('heart')
    g.victory([
        dict(art='castellan', title='The Relics',
             text="Castellan Hadrek takes the Litany and the Heart in his "
                  "own hands, and bows his head over the Burning Hand on "
                  "your Sergeant's arm.\n\n\"The Saint comes home,\" he "
                  "says. \"Nine hundred years. The Order will sing of "
                  "this squad.\""),
        dict(art='saint',
             text="The Unbending Vow turns for Terra with the relics in "
                  "her chapel. Behind her, at a safe distance, the "
                  "Benediction burns: the Castellan has ordered the wreck "
                  "cleansed by fire, every deck, so that nothing of the "
                  "Brood survives."),
        dict(art='title', title='The End',
             text="Your names are added to the Order's roll of honour, "
                  "beside the Saint's.\n\nYou may go on exploring the "
                  "wreck as long as you like.\n\nThank you for playing."),
    ])
    return True


