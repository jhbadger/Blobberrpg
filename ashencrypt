# --------------------------------------------------------------- the ending


def temple_hook(g, sq):
    """Bringing the crown to the temple ends the game."""
    if g.st.won or not g.has_item('crown'):
        return False
    g.take_item('crown')
    g.victory([
        dict(art='priestess', title='The Crown of Ash',
             text="Sister Maud takes the Crown of Ash in both hands. It is "
                  "so cold it burns. \"So it ends,\" she says, and lays it "
                  "on the altar fire.\n\nIt does not melt. It crumbles, "
                  "like a log that has burned all night, into a heap of "
                  "grey ash, and the fire goes out."),
        dict(text="That night no ash falls on Hollowmere. The chapel bell, "
                  "cracked these three months, is found whole in the "
                  "morning, and rings by itself until noon.\n\nThe people "
                  "say it is the saints. Thessaly says it is the old "
                  "binding, healed at last."),
        dict(art='guildmaster', title='The End',
             text="Your names are written in the Guild's book, beside the "
                  "saints who first laid the Ashen King to rest.\n\nThe "
                  "crypt is quiet now. You may wander Hollowmere and its "
                  "depths as long as you like.\n\nThank you for playing."),
    ])
    return True


