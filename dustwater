def purifier_hook(g, sq, nxt):
    """Bringing both parts home to the purifier ends the game."""
    if g.st.won:
        g.tell('The purifier hums, and clean water runs from its spout.', nxt)
        return
    core, cell = g.has_item('filtercore'), g.has_item('fusioncell')
    if not (core and cell):
        need = [n for n, have in (('a FILTER CORE from the waterworks under '
                                   'Carvel', core),
                                  ('a FUSION CELL from Facility Nine', cell))
                if not have]
        g.tell('The purifier coughs and shudders. A thin, bitter trickle '
               'runs from its spout.\n\nIt still needs ' +
               ' and '.join(need) + '.', nxt)
        return
    g.take_item('filtercore')
    g.take_item('fusioncell')
    pages = [
        dict(art='mags_face', title='The Purifier',
             text="Mags strips the purifier to its bones while the whole "
                  "village watches. In goes the filter core; in goes the "
                  "fusion cell. She throws the big switch.\n\nThe purifier "
                  "hums, a deep clean sound nobody has heard in years, and "
                  "water runs from its spout: clear, and cold, and sweet."),
        dict(art='elder_face', title='Dustwater',
             text="Elder Nan drinks first, as is her right, and then hands "
                  "the cup to you. \"The village owes you its life,\" she "
                  "says. \"We'll not forget it, not while there's a "
                  "Dustwater.\""),
    ]
    if g.has_item('seeds'):
        g.take_item('seeds')
        pages.append(dict(
            art='healer_face', title='The Seeds',
            text="Mother Bryony opens Dr Adebayo's seed tin with shaking "
                 "hands: wheat, beans, apples, a dozen things nobody in "
                 "Dustwater has ever tasted. With clean water, she says, "
                 "they will grow.\n\nNext spring there are green fields "
                 "around the village for the first time in a hundred "
                 "years."))
    pages.append(dict(
        art='dw_title', title='The End',
        text="The well is saved, and the wastes are a little less "
             "frightening than they were.\n\nYou may go on exploring them "
             "as long as you like.\n\nThank you for playing."))
    g.victory(pages)


