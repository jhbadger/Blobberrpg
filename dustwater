# What the different stocks may be born with, and what radiation may give.
PHYSICAL = ['natural_armor', 'quickness', 'thermal_vision', 'night_vision',
            'regeneration', 'increased_str', 'increased_dex', 'gigantism',
            'rad_resist', 'toxic_blood']
BEASTLY = PHYSICAL + ['echolocation', 'combat_empathy']
LEAFY = ['plant_bark', 'photosynthesis', 'regeneration', 'toxic_blood']
BODY_POWERS = ['ERAY', 'SHRK', 'OPTE', 'GAMA', 'POIS', 'TEMP']
MIND_POWERS = ['MTHR', 'FSCR', 'TKIN', 'HEAL', 'BADJ', 'KDIR', 'PREC',
               'LITE', 'SENS', 'DIRN', 'TELE']
PLANT_POWERS = ['THRN', 'SPOR', 'POIS']


def _pick(rng, pool, have, n=1):
    left = [p for p in pool if p not in have]
    rng.shuffle(left)
    return left[:n]


def new_character(c, rng):
    """Born mutations, by stock."""
    if c.race == 'Mutant Human':
        c.traits = _pick(rng, PHYSICAL, [])
        c.powers = _pick(rng, BODY_POWERS, []) + _pick(rng, MIND_POWERS, [])
    elif c.race == 'Mutant Animal':
        c.traits = _pick(rng, BEASTLY, [], 2)
        c.powers = _pick(rng, MIND_POWERS, [])
    elif c.race == 'Mutant Plant':
        c.traits = _pick(rng, LEAFY, [])
        c.powers = _pick(rng, PLANT_POWERS, []) + _pick(rng, MIND_POWERS, [])
    elif c.race == 'Android':
        c.traits = ['android_frame']


def start_hp(c, rng):
    """Mutant Future hit points: as many dice as Constitution, d8s for a
    pure human, d6s for anyone else; androids are built with fifty."""
    if c.race == 'Android':
        return 50
    die = 8 if c.race == 'Pure Human' else 6
    return max(8, sum(rng.randint(1, die) for _ in range(c.cn)))


def level_up(c, rng):
    """Mutant Future: each new level brings one random gain, not hit
    points."""
    r = rng.randint(1, 100)
    if r <= 10:
        c.extra['dmg'] = c.extra.get('dmg', 0) + 1
        return ['%s hits harder: +1 damage.' % c.name]
    if r <= 20:
        c.extra['hit'] = c.extra.get('hit', 0) + 1
        return ['%s fights more surely: +1 to hit.' % c.name]
    stats = ['iq', 'lk'] if c.race == 'Android' else list(rules.STATS)
    s = rng.choice(stats)
    setattr(c, s, getattr(c, s) + 1)
    notes = ['%s gains a point of %s.' % (c.name, rules.STAT_NAMES[s])]
    if s == 'cn' and c.race != 'Android':
        gain = rng.randint(1, 8 if c.race == 'Pure Human' else 6)
        c.maxhp += gain
        c.hp += gain
        notes.append('And %d more hit points.' % gain)
    return notes


def focus(c, level):
    """Focus for using mutations: Willpower and level."""
    if not c.powers:
        return 0
    return max(3, c.lk - 4 + 3 * (level - 1))


# Saving throws by level: energy (blasts, traps), poison, stun, radiation.
SAVES = [(0, (17, 14, 16, 15)), (1, (15, 12, 14, 13)), (4, (13, 10, 12, 11)),
         (7, (9, 8, 10, 9)), (10, (7, 6, 8, 7)), (13, (5, 4, 6, 5))]
SAVE_COL = {'breath': 0, 'trap': 0, 'poison': 1, 'paralyze': 2,
            'radiation': 3}


def save(c, kind, rng):
    row = [s for lvl, s in SAVES if c.level >= lvl][-1]
    need = row[SAVE_COL.get(kind, 0)]
    adj = 0
    if kind in ('poison', 'radiation'):
        adj = rules.bonus(c.cn)
    elif kind == 'paralyze':
        adj = rules.bonus(c.lk)
    elif kind in ('breath', 'trap'):
        adj = rules.bonus(c.dx)
    return rng.randint(1, 20) + adj >= need


def on_radiation(g, c):
    """Enough radiation gives a mutant a new mutation."""
    if c.race in ('Pure Human', 'Android'):
        return None
    rng = g.rng
    if c.race == 'Mutant Plant':
        pools = [(LEAFY, 'traits'), (PLANT_POWERS + MIND_POWERS, 'powers')]
    elif c.race == 'Mutant Animal':
        pools = [(BEASTLY, 'traits'), (MIND_POWERS, 'powers')]
    else:
        pools = [(PHYSICAL, 'traits'), (BODY_POWERS + MIND_POWERS, 'powers')]
    rng.shuffle(pools)
    for pool, kind in pools:
        new = _pick(rng, pool, getattr(c, kind))
        if new:
            getattr(c, kind).append(new[0])
            if kind == 'powers':
                old = c.maxsp
                c.maxsp = c.sp_for_level(c.level)
                c.sp += c.maxsp - old
                name = rules.SPELLS[new[0]]['name']
            else:
                name = rules.TRAITS[new[0]]['name']
            return 'The radiation twists %s: a new mutation, %s!' % (c.name,
                                                                   name)
    return None


rules.HOOKS.update(new_character=new_character, start_hp=start_hp,
                   level_up=level_up, sp=focus, save=save,
                   on_radiation=on_radiation)

